# ---------------------------------------------------------------------------
# Wassily backend (Python). Same variable names as the Next.js server, so one
# .env can drive either runtime.

# simulated = synthetic market, labelled SIMULATED
# chain     = real Robinhood Chain launches read on-chain, labelled LIVE
DATA_SOURCE=simulated
CHAIN=robinhood
PERSONA=hoeffding
# BOUND=
# CYCLE_SECONDS=3600        # default: 3600 live, 90 simulated
POLL_SECONDS=60

RPC_URL=https://rpc.mainnet.chain.robinhood.com
GECKO_API=https://api.geckoterminal.com/api/v2
GECKO_PER_MINUTE=28
BACKFILL_DAYS=14
BACKFILL_SAMPLE=0.5

# PERSIST=true
DATA_DIR=data

# HTTP service
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Force the pure-Python IRLS path even when numpy is installed (parity checks).
# WASSILY_PURE_PYTHON=1
