# ---------------------------------------------------------------------------
# Public (baked into the browser bundle at build time). Blank hides the element.
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

# Persona / bound the site opens with.
# Personas: hoeffding | kolmogorov | bayes | chebyshev | bernstein | wilcoxon
# Bounds:   vc | vc-bootstrap | bootstrap | hoeffding | bernstein | dkw | wilcoxon | cantelli | bayes
NEXT_PUBLIC_DEFAULT_PERSONA=hoeffding
NEXT_PUBLIC_DEFAULT_BOUND=

# Hero media panel: your own video in public/. Muted, looped, paused off-screen.
# Blank uses these defaults; the poster shows until the video can play.
NEXT_PUBLIC_HERO_VIDEO=/videos/hero.mp4
NEXT_PUBLIC_HERO_POSTER=/videos/hero-poster.jpg

# ---------------------------------------------------------------------------
# Server (read at runtime).
# simulated = synthetic market, labelled SIMULATED
# chain     = real Robinhood Chain launches read on-chain, labelled LIVE (npm run dev:live / start:live)
#             ("dexscreener" is still accepted and means the same)
DATA_SOURCE=simulated
CHAIN=robinhood
PERSONA=hoeffding
# BOUND=
# CYCLE_SECONDS=3600        # default: 3600 live, 90 simulated
POLL_SECONDS=60

# Live source. Launches come from the RPC; each token's 48h peak comes from GeckoTerminal's
# hourly candles (free tier: keep GECKO_PER_MINUTE under 30); holders are replayed from transfers.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
GECKO_API=https://api.geckoterminal.com/api/v2
GECKO_PER_MINUTE=28
# Days of past launches labelled on the first start (newest first). 0 = only follow new launches.
BACKFILL_DAYS=14
# Share of past launches looked up, picked uniformly at random by address (1 = all; slower).
BACKFILL_SAMPLE=0.5

# Persistence (default true for live, false for simulated)
# PERSIST=true
DATA_DIR=data
